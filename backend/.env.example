# =====================================================================================================
# SEGY · Variables de entorno (referencia completa)
# Copia este archivo como .env y ajusta los valores. En Hostinger puedes definirlas en hPanel en lugar
# del archivo .env (las del panel tienen prioridad). NUNCA subas tu .env a GitHub.
# =====================================================================================================

# --- Entorno -----------------------------------------------------------------------------------------
# production en el servidor · development en tu computador
NODE_ENV=development
PORT=3400
HOST=0.0.0.0
TZ=America/Bogota

# Dominio público, sin barra final. Se usa en los enlaces de comprobantes y del seguimiento web.
APP_URL=

# Secreto de la aplicación (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si se deja vacío, se genera uno y se guarda en DATA_DIR/.app-secret.
APP_SECRET=

# --- Datos -------------------------------------------------------------------------------------------
# Carpeta de la base de datos, fotos, facturas y respaldos. En producción usa una ruta ABSOLUTA FUERA de
# la carpeta de la aplicación para que sobreviva a cada nueva publicación.
DATA_DIR=./data
# DB_PATH=            # opcional; por defecto DATA_DIR/segy.db

# --- Primer administrador (solo se usa si la base no tiene usuarios) ---------------------------------
# Tras el primer ingreso el sistema obliga a cambiar la contraseña. Luego puedes borrar estas variables.
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

# --- Seguridad (los valores por defecto son seguros) -------------------------------------------------
# Proxy inverso del hosting: número de saltos de confianza (Hostinger/Nginx: 1)
TRUST_PROXY=1
# Redirigir a HTTPS y cookie Secure (por defecto: true en producción)
FORCE_HTTPS=
COOKIE_SECURE=
# Duración de la sesión (horas) y cierre por inactividad (minutos)
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
# Costo de bcrypt (10-14 recomendado) y longitud mínima de contraseña
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
# Bloqueo de cuenta: intentos fallidos y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Peticiones por IP cada 5 minutos a la API
RATE_LIMIT_API=1500
# Tamaño máximo de peticiones (general / con archivos)
BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=20mb

# --- Respaldos automáticos de la base de datos ------------------------------------------------------
BACKUPS_AUTO=true
BACKUPS_KEEP=14

# --- Integraciones opcionales ------------------------------------------------------------------------
# OCR de facturas y asistente Astro (Anthropic)
ANTHROPIC_API_KEY=
# Asistente con OpenRouter (alternativa)
OPENROUTER_API_KEY=
# TRM oficial (datos.gov.co): token opcional para más consultas
DATOS_GOV_APP_TOKEN=
# Sincronización de campañas publicitarias
META_ADS_TOKEN=
META_ADS_CUENTA=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# --- Registro ---------------------------------------------------------------------------------------
LOG_LEVEL=info
