# SEGY · desarrollo local. Copiar como .env:   cp .env.development.example .env
NODE_ENV=development
PORT=3400
TZ=America/Bogota
DATA_DIR=./data
# En local no hay HTTPS: la cookie no lleva Secure
FORCE_HTTPS=false
COOKIE_SECURE=false
# Muestra en la pantalla de acceso el usuario de demostración (solo si cargaste `npm run seed`)
MOSTRAR_DEMO=true
LOG_LEVEL=debug
# Opcional: OCR de facturas y asistente
ANTHROPIC_API_KEY=
