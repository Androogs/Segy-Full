# SEGY · producción (Hostinger). Define estas variables en hPanel o crea un archivo .env con ellas.
NODE_ENV=production
PORT=3400
TZ=America/Bogota

# Tu dominio con https, sin barra final
APP_URL=https://panel.tudominio.com

# Pega aquí un secreto aleatorio de 48+ caracteres (ver comando en .env.example)
APP_SECRET=

# Ruta ABSOLUTA fuera de la carpeta de la app (ejemplo en Hostinger: /home/u123456789/segy-data)
DATA_DIR=/home/u123456789/segy-data

# Primer administrador (bórralas después del primer ingreso)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

TRUST_PROXY=1
FORCE_HTTPS=true
COOKIE_SECURE=true
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
BACKUPS_AUTO=true
BACKUPS_KEEP=14
LOG_LEVEL=info

# Opcionales
ANTHROPIC_API_KEY=
DATOS_GOV_APP_TOKEN=
